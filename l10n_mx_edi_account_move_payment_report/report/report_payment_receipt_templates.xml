<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Payment receipt of a payment (native in 20.0) -->
    <template
        id="report_payment_document"
        inherit_id="l10n_mx_edi.report_payment_document"
    >
        <xpath expr="//div[@name='l10n_mx_edi_supplier_rfc']/span[2]" position="before">
            <span t-out="o.company_id.vat" />
        </xpath>
        <xpath expr="//div[@name='l10n_mx_edi_payment_method']" position="after">
            <!-- Without CFDI (PUE) the native Payment Way is not shown -->
            <div
                t-if="not cfdi and o.l10n_mx_edi_payment_method_id"
                name="l10n_mx_edi_payment_method_pue"
            >
                <strong>Payment Way:</strong>
                <span
                    t-out="'%s - %s' % (o.l10n_mx_edi_payment_method_id.code, o.l10n_mx_edi_payment_method_id.name)"
                />
            </div>
            <div
                name="fiscal_regime"
                t-if="cfdi and cfdi['sello_sat'] and cfdi['stamp_date'] and o.partner_id.l10n_mx_edi_fiscal_regime"
            >
                Fiscal Regime: (<span
                t-out="o.partner_id.l10n_mx_edi_fiscal_regime"
            />) <span t-field="o.partner_id.l10n_mx_edi_fiscal_regime" />
            </div>
        </xpath>
    </template>
</odoo>
