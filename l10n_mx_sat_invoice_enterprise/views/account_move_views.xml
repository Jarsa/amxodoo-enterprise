<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n_mx_sat.enterprise</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_mx_sat_invoice.view_move_form" />
        <field name="arch" type="xml">
            <!-- An invoice with fiscal folio is linked to its CFDI automatically -->
            <button name="action_l10n_mx_sat_link_document" position="attributes">
                <attribute
                    name="invisible"
                    add="l10n_mx_edi_cfdi_uuid"
                    separator=" or "
                />
            </button>
        </field>
    </record>
</odoo>
